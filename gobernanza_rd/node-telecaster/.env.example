# Node Telecaster Configuration
# GobernanzaRD Magic Algorithm Courage Broadcasting Service

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Redis (for BullMQ queues and pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Python Backend API
PYTHON_API_URL=http://localhost:8000
PYTHON_API_KEY=internal-service-key

# Database (for direct queries if needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gobernanza_rd

# WhatsApp Business API (via BSP)
WHATSAPP_BSP=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# SMS Providers
CLARO_SMS_API_URL=https://api.claro.com.do/sms/v1
CLARO_SMS_TOKEN=
ALTICE_SMS_API_URL=https://api.altice.com.do/sms/v1
ALTICE_SMS_TOKEN=
VIVA_SMS_API_URL=https://api.viva.com.do/sms/v1
VIVA_SMS_TOKEN=

# USSD Gateway
USSD_GATEWAY_URL=http://localhost:3002
USSD_CODE=*462#

# Cell Broadcast (COE/INDOTEL coordination)
CELL_BROADCAST_ENABLED=false
COE_API_URL=https://api.coe.gob.do
INDOTEL_API_URL=https://api.indotel.gob.do

# Push Notifications (Firebase/APNs)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# Discord Bot (for governance notifications)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENT_CHANNEL=

# Magic Algorithm Courage - Core Configuration
TELECASTER_MAGIC_ENABLED=true
TELECASTER_ALGO_TYPE=courage
TELECASTER_COURAGE_LEVEL=maximum
TELECASTER_BROADCAST_INTERVAL_MS=1000
TELECASTER_MAX_CONCURRENT_BROADCASTS=1000

# Security
JWT_SECRET=telecaster-jwt-secret-change-in-production
JWT_EXPIRY=24h
API_KEY=telecaster-api-key-change-in-production

# Monitoring
LOG_LEVEL=info
METRICS_ENABLED=true
PROMETHEUS_PORT=9091

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000